# ---- Database (required) ----
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Local:    postgres://moon:moon@localhost:5432/moonpadel
DATABASE_URL=

# ---- Supabase Auth + Storage (required in production) ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to upload player photos and by `npm run admin:create`. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Local development login (only when Supabase Auth is not configured) ----
# A long random string used to sign the local admin session cookie.
# Local login is refused in production unless ALLOW_LOCAL_AUTH=true.
AUTH_SECRET=
ALLOW_LOCAL_AUTH=

# ---- Player login (see README > Player accounts) ----
# Set to true once the provider is switched on in Supabase.
PLAYER_LOGIN_GOOGLE=
PLAYER_LOGIN_EMAIL=

# Public URL of the site, used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
