# Netlify headers (works for Git deploys and drag-and-drop). On Hostinger, .htaccess does the same job.
# Paths must not overlap: Netlify joins values when two rules match. Pages and config.js keep Netlify's default (always revalidate).
# PRE-LAUNCH: the X-Robots-Tag line keeps search engines out while the site still has [placeholders]. build_site.py --launch removes it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/site.js
  Cache-Control: public, max-age=604800

