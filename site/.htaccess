# Moon Padel site on Hostinger (Apache / LiteSpeed). Upload this file to public_html with the rest of the site.
# Does the same job as netlify.toml: clean URLs, 404 page, security headers, caching and compression.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Always HTTPS. Turn on the free SSL certificate in hPanel first.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. One address: send www. to the bare domain. To prefer www instead, swap these two lines for the www version in WEBSITE.md.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Clean URLs: /events.html -> /events, /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # 4. Trailing slash on a page: /events/ -> /events
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 5. Serve /events from events.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ /$1.html [L]

  # 6. Keep notes and tooling out of reach
  RewriteRule (^|/)\. - [F]
  RewriteRule \.(md|py|toml|zip)$ - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # PRE-LAUNCH START: keeps search engines out while the site still has [placeholders].
  # tools/build_site.py --launch removes this block. Or delete it by hand at launch.
  Header always set X-Robots-Tag "noindex, nofollow"
  # PRE-LAUNCH END

  # Pages and the settings file always fresh; everything else cached.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(site\.css|site\.js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType text/calendar .ics
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .json .webmanifest .txt .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml application/xml image/x-icon
</IfModule>
